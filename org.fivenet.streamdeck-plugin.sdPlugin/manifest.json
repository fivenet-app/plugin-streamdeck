{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "FiveNet for Stream Deck",
    "Version": "0.4.5.1",
    "Author": "PhilTec-Philip",
    "Actions": [
        {
            "Name": "Login",
            "UUID": "org.fivenet.streamdeck-plugin.login",
            "Icon": "imgs/actions/login/icon",
            "Tooltip": "Log in to your FiveNet server",
            "PropertyInspectorPath": "ui/login.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/login/key",
                    "TitleAlignment": "middle",
                    "Title": "Login"
                }
            ],
            "UserTitleEnabled": true
        },
        {
            "Name": "Select Character",
            "UUID": "org.fivenet.streamdeck-plugin.char-select",
            "Icon": "imgs/actions/char-select/icon",
            "Tooltip": "Select or switch the active character",
            "PropertyInspectorPath": "ui/char-select.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/char-select/key",
                    "TitleAlignment": "middle",
                    "Title": "Character"
                }
            ],
            "UserTitleEnabled": true
        },
        {
            "Name": "Open Dispatches",
            "UUID": "org.fivenet.streamdeck-plugin.dispatch-status",
            "Icon": "imgs/actions/dispatch-status/icon",
            "Tooltip": "Shows the number of open dispatches",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/dispatch-status/key",
                    "TitleAlignment": "middle",
                    "Title": "0"
                }
            ]
        },
        {
            "Name": "Dispatch Status",
            "UUID": "org.fivenet.streamdeck-plugin.dispatch-status-display",
            "Icon": "imgs/actions/dispatch-status-display/icon",
            "Tooltip": "Shows the status of the accepted dispatch",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/dispatch-status-display/key",
                    "TitleAlignment": "middle",
                    "Title": "Status"
                }
            ]
        },
        {
            "Name": "Set Dispatch Status",
            "UUID": "org.fivenet.streamdeck-plugin.dispatch-setzen",
            "Icon": "imgs/actions/dispatch-setzen/icon",
            "Tooltip": "Sets the status of the accepted dispatch",
            "PropertyInspectorPath": "ui/dispatch-setzen.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/dispatch-setzen/key",
                    "TitleAlignment": "middle",
                    "Title": "Set"
                }
            ]
        },
        {
            "Name": "Accept or Decline Dispatch",
            "UUID": "org.fivenet.streamdeck-plugin.take-dispatch",
            "Icon": "imgs/actions/take-dispatch/icon",
            "Tooltip": "Accepts or declines an assigned dispatch",
            "PropertyInspectorPath": "ui/take-dispatch.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/take-dispatch/key",
                    "TitleAlignment": "middle",
                    "Title": "Take"
                }
            ]
        },
        {
            "Name": "Set Unit Status",
            "UUID": "org.fivenet.streamdeck-plugin.unit-status",
            "Icon": "imgs/actions/unit-status/icon",
            "Tooltip": "Sets the status of your unit",
            "PropertyInspectorPath": "ui/unit-status.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/unit-status/key",
                    "TitleAlignment": "middle",
                    "Title": "Status"
                }
            ]
        },
        {
            "Name": "Unit Status",
            "UUID": "org.fivenet.streamdeck-plugin.unit-status-display",
            "Icon": "imgs/actions/unit-status-display/icon",
            "Tooltip": "Shows the current status of your unit",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/unit-status-display/key",
                    "TitleAlignment": "middle",
                    "Title": "Status"
                }
            ]
        },
        {
            "Name": "Join Unit",
            "UUID": "org.fivenet.streamdeck-plugin.join-unit",
            "Icon": "imgs/actions/join-unit/icon",
            "Tooltip": "Join a unit",
            "PropertyInspectorPath": "ui/join-unit.html",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/join-unit/key",
                    "TitleAlignment": "middle",
                    "Title": "Join"
                }
            ]
        },
        {
            "Name": "Notifications",
            "UUID": "org.fivenet.streamdeck-plugin.notification-count",
            "Icon": "imgs/actions/notification-count/icon",
            "Tooltip": "Shows the number of unread notifications",
            "Controllers": [
                "Keypad"
            ],
            "States": [
                {
                    "Image": "imgs/actions/notification-count/key",
                    "TitleAlignment": "middle",
                    "Title": "0"
                }
            ]
        }
    ],
    "Category": "FiveNet for Stream Deck",
    "CategoryIcon": "imgs/plugin/category-icon",
    "CodePath": "bin/plugin.js",
    "Description": "Control FiveNet units, dispatches, and notifications from your Stream Deck.",
    "Icon": "imgs/plugin/marketplace",
    "URL": "https://github.com/fivenet-app/plugin-streamdeck",
    "SupportURL": "https://github.com/fivenet-app/plugin-streamdeck/issues",
    "SDKVersion": 3,
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "12"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Nodejs": {
        "Version": "24"
    },
    "UUID": "org.fivenet.streamdeck-plugin"
}